// Workerd-inspired symbolic service binding compiler, native Oreslang only.
// NOT a network/socket capability and NOT an ActorRef. The trusted supervisor
// must resolve every YAML target through a pre-approved code-image registry.
// Registry entries are trusted runtime state; YAML cannot create or widen them.
import module proxy_yaml from "./proxy_yaml";
import module generation from "./generation";
import module route_policy from "./route_policy";

define module service_bindings as
  pub define class CodeImage as
    pub val String target;
    pub val String abi;
    pub val bool network_capable;
    pub constructor(String target, String abi, bool network_capable) {
      self.target = target;
      self.abi = abi;
      self.network_capable = network_capable;
    }
  end

  pub define class Registry as
    val Array<CodeImage> images;

    private constructor(Array<CodeImage> source) {
      self.images = new Array<CodeImage>();
      for (const image of source) {
        self.images.add(new CodeImage(image.target, image.abi,
          image.network_capable));
      }
    }

    pub fnc contains(String target): bool {
      for (const image of self.images) {
        if image.target == target; then return true; fi
      }
      return false;
    }

    pub fnc image(String target): Result<CodeImage, String> {
      for (const image of self.images) {
        if image.target == target; then
          return Ok(new CodeImage(image.target, image.abi,
            image.network_capable));
        fi
      }
      return Err("unregistered actor code image");
    }
  end

  // Supervisor-side registry constructor. A serving runtime must keep this
  // object actor-owned and build it from trusted code-image/capability metadata,
  // never from request bytes or YAML.
  pub fnc registry(Array<CodeImage> images): Result<Registry, String> {
    if images.size == 0 || images.size > 128; then
      return Err("trusted actor registry must contain 1..128 images");
    fi
    let Array<CodeImage> checked = new Array<CodeImage>();
    for (const image of images) {
      if !proxy_yaml.valid_identifier(image.target) ||
        !proxy_yaml.valid_identifier(image.abi); then
        return Err("invalid trusted code-image metadata");
      fi
      for (const existing of checked) {
        if existing.target == image.target; then
          return Err("duplicate trusted actor target");
        fi
      }
      checked.add(new CodeImage(image.target, image.abi,
        image.network_capable));
    }
    return Ok(new Registry(checked));
  }

  pub define class Binding as
    pub val int epoch;
    pub val String name;
    pub val String kind;
    pub val String target;
    pub val String abi;
    pub val bool network_capable;
    private constructor(int epoch, String name, String kind, String target,
                        String abi, bool network_capable) {
      self.epoch = epoch;
      self.name = name;
      self.kind = kind;
      self.target = target;
      self.abi = abi;
      self.network_capable = network_capable;
    }
  end

  pub fnc bind(borrow generation.Snapshot snapshot, borrow Registry trusted,
               String service_name): Result<Binding, String> {
    // Snapshot epochs are minted and range-checked by generation.Coordinator.
    // Avoid re-validating an imported field here; binding only accepts a
    // coordinator snapshot and preserves its epoch unchanged.
    if !proxy_yaml.valid_identifier(service_name); then
      return Err("invalid service binding request");
    fi
    val proxy_yaml.Config configuration = snapshot.configuration;
    for (const service of configuration.services) {
      if service.name == service_name; then
        if service.kind != "actor"; then
          return Err("unsupported service binding kind");
        fi
        val approved = trusted.image(service.target);
        if approved.is_err(); then
          return Err("service target is not a trusted code image");
        fi
        val image = approved.unwrap();
        return Ok(new Binding(snapshot.epoch, service.name,
          service.kind, service.target, image.abi, image.network_capable));
      fi
    }
    return Err("undeclared service binding");
  }

  // Reverse routes can target symbolic local actor services without gaining
  // network authority. Route, service and trusted image are resolved against
  // the SAME immutable snapshot/registry pair.
  pub fnc reverse_route(borrow generation.Snapshot snapshot,
                        borrow Registry trusted, String host,
                        String path): Result<Binding, String> {
    if snapshot.configuration.mode != "reverse"; then
      return Err("not a reverse proxy configuration");
    fi
    val selected = route_policy.select(rt borrow snapshot.configuration, host, path);
    if selected.is_err(); then return Err("route not found"); fi
    val route = selected.unwrap();
    if !proxy_yaml.valid_service_ref(route.upstream); then
      return Err("route is not a service binding");
    fi
    val parts = route.upstream.split_literal("service://");
    if parts.size != 2; then return Err("malformed local binding"); fi
    return bind(snapshot, trusted, parts.get(1));
  }
end
