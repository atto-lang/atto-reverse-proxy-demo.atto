// Deterministic declarative middleware evaluation over immutable definitions.
// This pure proof helper handles one canonical lookup for tests only; a live
// HTTP adapter must provide complete per-request header lookup and enforcement.
import module proxy_yaml from "./proxy_yaml";
define module middleware_policy as
  pub fnc evaluate(borrow proxy_yaml.Config snapshot, String chain,
                   String supplied_header, String supplied_value): Result<bool, String> {
    if chain == ""; then return Ok(true); fi
    for (const id of chain.split_literal(",")) {
      let bool found = false;
      for (const rule of snapshot.middleware) {
        if rule.name == id; then
          if found; then return Err("duplicate middleware identifier in snapshot"); fi
          found = true;
          // Config is publicly constructible; never treat unknown or
          // duplicated policy entries as implicit allow.
          if !(rule.kind == "deny" || rule.kind == "trace" ||
            rule.kind == "require_header"); then
            return Err("unknown middleware kind in snapshot");
          fi
          if rule.kind == "deny"; then return Ok(false); fi
          if rule.kind == "require_header" &&
            (supplied_header != rule.header || supplied_value == ""); then
            return Ok(false);
          fi
          // 'trace' only marks the tracing intent; it does not emit telemetry.
        fi
      }
      if !found; then return Err("middleware identifier is not in snapshot"); fi
    }
    return Ok(true);
  }
end
