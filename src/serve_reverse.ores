// Opt-in loopback-only ingress proof. Routes and middleware operate on a
// single parsed snapshot in the Oreslang supervisor. No outbound proxy call.
// HTTP upstream routes return 501; a pre-approved local actor service can
// respond through the existing guest HTTP actor adapter. Not a full proxy.
// This is NOT src/main.ores and is intentionally NOT a production entrypoint.
import module proxy_yaml from "./proxy_yaml";
import module proxy_wire from "./proxy_wire";
import module route_policy from "./route_policy";
import module config_path from "./config_path";
import module generation from "./generation";
import module service_bindings from "./service_bindings";

// Reusable actor lifecycle: pooled handlers return after each request and do
// not self.end(). HTTP transport owns the FD and single-use claim generation.
define isoactor UpstreamUnavailable as
  receive(ActorMail<String> mail): void {
    val exchange = http.claim(mail.value);
    await exchange.respond(501, "text/plain; charset=utf-8",
      "Upstream forwarding unavailable in this runtime");
    return;
  }
end

// Pre-registered code image. Only this exact image is bindable in this
// demonstration. No dynamic eval, unrestricted ActorRef or ambient fetch.
define isoactor HelloV1 as
  receive(ActorMail<String> mail): void {
    val exchange = http.claim(mail.value);
    await exchange.respond(200, "text/plain; charset=utf-8",
      "hello from native Oreslang actor service");
    return;
  }
end

pub async routine main(): int {
  val selected = env.get("ores_proxy_conf_yaml");
  if selected.is_none(); then
    stdio.println("ERROR: ores_proxy_conf_yaml required");
    return 64;
  fi
  val String path = selected.unwrap();
  if !config_path.valid(path); then
    stdio.println("ERROR: config path must be canonical and absolute");
    return 65;
  fi
  if fs.is_symlink(path) || !fs.exists(path) || fs.is_dir(path); then
    stdio.println("ERROR: nonregular configuration");
    return 65;
  fi
  val parsed = proxy_yaml.parse(fs.read_text(path), "reverse");
  if parsed.is_err(); then
    stdio.println("ERROR: invalid proxy config");
    return 65;
  fi
  val config = parsed.unwrap();
  val snapshot = new generation.Snapshot(1, config);

  // Port conversion and source-configurable bind scopes are not yet admitted.
  // Never accidentally expose this transport proof on a public listener.
  if config.listen_host != "127.0.0.1" || config.listen_port != "8080" ||
    config.actor_pool != "100" || config.max_inflight != "1024"; then
    stdio.println("ERROR: ingress proof only supports loopback:8080 and bounded 100/1024 profile");
    return 78;
  fi

  // Keep the total reusable HTTP actor allocation within the YAML actors=100
  // budget: 50 actor-service handlers + 50 unavailable-upstream handlers.
  // Pooled actor count is NOT HTTP admission or the carrier thread count.
  val unavailable = http.handler("UpstreamUnavailable").pooled(50);
  val hello = http.handler("HelloV1").pooled(50);
  val server = http.listen("127.0.0.1", 8080, 1024, 65536, 30000);
  stdio.println("EXPERIMENTAL loopback actor ingress; HTTP upstream forwarding returns 501");
  loop {
    val exchange = await server.accept();
    val String host = exchange.header("Host");
    val String request_line = exchange.method + " " + exchange.target + " HTTP/1.1";
    val admitted = proxy_wire.reverse(request_line, host);
    if admitted.is_err(); then
      await exchange.respond(400, "text/plain; charset=utf-8", "Noncanonical request");
      continue;
    fi
    val matched = route_policy.select(rt borrow config, host, exchange.target);
    if matched.is_err(); then
      await exchange.respond(404, "text/plain; charset=utf-8", "No route");
      continue;
    fi
    val target = matched.unwrap();
    if !proxy_yaml.valid_service_ref(target.upstream) &&
      proxy_wire.upstream_origin(target.upstream).is_err(); then
      await exchange.respond(502, "text/plain; charset=utf-8", "Invalid upstream origin");
      continue;
    fi

    let bool permit = true;
    if target.middleware != ""; then
      for (const name of target.middleware.split_literal(",")) {
        let bool present = false;
        for (const rule of config.middleware) {
          if rule.name == name; then
            present = true;
            if rule.kind == "deny"; then permit = false; fi
            if rule.kind == "require_header" &&
              exchange.header(rule.header) == ""; then
              permit = false;
            fi
            if !(rule.kind == "deny" || rule.kind == "require_header" ||
              rule.kind == "trace"); then
              permit = false;
            fi
          fi
        }
        if !present; then permit = false; fi
      }
    fi
    if !permit; then
      await exchange.respond(403, "text/plain; charset=utf-8", "Request denied");
      continue;
    fi
    if proxy_yaml.valid_service_ref(target.upstream); then
      val bound = service_bindings.reverse_route(rt borrow snapshot,
        host, exchange.target);
      if bound.is_err(); then
        await exchange.respond(503, "text/plain; charset=utf-8",
          "Service binding unavailable");
        continue;
      fi
      if bound.unwrap().target == "hello-v1"; then
        hello.dispatch(exchange);
      else
        await exchange.respond(501, "text/plain; charset=utf-8",
          "Actor image not registered in this demonstration");
      fi
      continue;
    fi
    unavailable.dispatch(exchange);
  }
  return 0;
}
