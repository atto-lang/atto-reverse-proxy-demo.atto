// Lexical POSIX configuration-path admission. NOT race-free filesystem access.
// Production hostile-path protection requires a scoped openat-style descriptor.
import module admission_text from "./admission_text";
define module config_path as
  pub fnc valid(String path): bool {
    if !admission_text.control_free(path) || path == "" || !path.starts_with("/") ||
      path.ends_with("/") || path.contains_literal("//") ||
      path.contains_literal("/./") || path.ends_with("/.") ||
      path.contains_literal("/../") || path.ends_with("/..") ||
      path.contains_literal("\\") || path.contains_literal("\n") ||
      path.contains_literal("\r") || path.contains_literal("\t") ||
      path.contains_literal("\u0000") || path.contains_literal("\u001b") ||
      path.contains_literal("\u007f"); then return false; fi
    return true;
  }
end

