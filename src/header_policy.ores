// Native Oreslang HTTP proxy header admission predicates.
// Caller MUST perform raw byte parser/framing, duplicate header handling,
// comma-token parsing and canonical lowercase conversion before invoking this.
// These helpers NEVER write bytes, authenticate clients or grant network access.
define module header_policy as
  fnc token(String key): bool {
    if key == "" || key.starts_with("-") || key.ends_with("-") ||
      key.contains_literal(":") || key.contains_literal(" ") ||
      key.contains_literal("\r") || key.contains_literal("\n") ||
      key.contains_literal("\t"); then return false; fi
    val String residue = key
      .replace_literal("a","").replace_literal("b","").replace_literal("c","")
      .replace_literal("d","").replace_literal("e","").replace_literal("f","")
      .replace_literal("g","").replace_literal("h","").replace_literal("i","")
      .replace_literal("j","").replace_literal("k","").replace_literal("l","")
      .replace_literal("m","").replace_literal("n","").replace_literal("o","")
      .replace_literal("p","").replace_literal("q","").replace_literal("r","")
      .replace_literal("s","").replace_literal("t","").replace_literal("u","")
      .replace_literal("v","").replace_literal("w","").replace_literal("x","")
      .replace_literal("y","").replace_literal("z","").replace_literal("-","")
      .replace_literal("0","").replace_literal("1","").replace_literal("2","")
      .replace_literal("3","").replace_literal("4","").replace_literal("5","")
      .replace_literal("6","").replace_literal("7","").replace_literal("8","")
      .replace_literal("9","");
    return residue == "";
  }

  pub fnc canonical_name(String key): bool { return token(key); }

  pub fnc value_safe(String value): bool {
    return !value.contains_literal("\r") &&
      !value.contains_literal("\n") &&
      !value.contains_literal("\u0000") &&
      !value.contains_literal("\t");
  }

  // Dynamic Connection hop-by-hop nominations must be normalized and removed
  // on both request and response. This function additionally rejects malformed
  // tokens in the nomination list; caller must reject malformed whole message.
  pub fnc connection_safe(String key, String connection_tokens): bool {
    if !token(key); then return false; fi
    if connection_tokens == ""; then return true; fi
    if connection_tokens.starts_with(",") || connection_tokens.ends_with(",") ||
      connection_tokens.contains_literal(",,"); then return false; fi
    for (const original of connection_tokens.split_literal(",")) {
      val String nominated = original.trim();
      if !token(nominated); then return false; fi
      if key == nominated; then return false; fi
    }
    return true;
  }

  // Staged nominal enum; compiler execution support remains gated.
  // Other does not discard the original extension name: the caller keeps
  // key for exact Connection-token removal and HTTP serialization.
  define enum HeaderName as
    Connection
    KeepAlive
    ProxyConnection
    TE
    Trailer
    TransferEncoding
    Upgrade
    Http2Settings
    ProxyAuthenticate
    ProxyAuthorization
    Host
    ContentLength
    Authorization
    Cookie
    Forwarded
    XForwardedFor
    XForwardedHost
    XForwardedProto
    Via
    ContentEncoding
    ContentRange
    Server
    Date
    Accept
    ContentType
    SetCookie
    Other
  end

  // Canonical lowercase names only; validate the raw header name first.
  pub fnc known_header(String key): HeaderName {
    if key == "connection"; then return HeaderName.Connection; fi
    if key == "keep-alive"; then return HeaderName.KeepAlive; fi
    if key == "proxy-connection"; then return HeaderName.ProxyConnection; fi
    if key == "te"; then return HeaderName.TE; fi
    if key == "trailer"; then return HeaderName.Trailer; fi
    if key == "transfer-encoding"; then return HeaderName.TransferEncoding; fi
    if key == "upgrade"; then return HeaderName.Upgrade; fi
    if key == "http2-settings"; then return HeaderName.Http2Settings; fi
    if key == "proxy-authenticate"; then return HeaderName.ProxyAuthenticate; fi
    if key == "proxy-authorization"; then return HeaderName.ProxyAuthorization; fi
    if key == "host"; then return HeaderName.Host; fi
    if key == "content-length"; then return HeaderName.ContentLength; fi
    if key == "authorization"; then return HeaderName.Authorization; fi
    if key == "cookie"; then return HeaderName.Cookie; fi
    if key == "forwarded"; then return HeaderName.Forwarded; fi
    if key == "x-forwarded-for"; then return HeaderName.XForwardedFor; fi
    if key == "x-forwarded-host"; then return HeaderName.XForwardedHost; fi
    if key == "x-forwarded-proto"; then return HeaderName.XForwardedProto; fi
    if key == "via"; then return HeaderName.Via; fi
    if key == "content-encoding"; then return HeaderName.ContentEncoding; fi
    if key == "content-range"; then return HeaderName.ContentRange; fi
    if key == "server"; then return HeaderName.Server; fi
    if key == "date"; then return HeaderName.Date; fi
    if key == "accept"; then return HeaderName.Accept; fi
    if key == "content-type"; then return HeaderName.ContentType; fi
    if key == "set-cookie"; then return HeaderName.SetCookie; fi
    return HeaderName.Other;
  }

  fnc hop_by_hop(HeaderName header): bool {
    return header == HeaderName.Connection ||
      header == HeaderName.KeepAlive ||
      header == HeaderName.ProxyConnection ||
      header == HeaderName.TE ||
      header == HeaderName.Trailer ||
      header == HeaderName.TransferEncoding ||
      header == HeaderName.Upgrade ||
      header == HeaderName.Http2Settings;
  }

  // Proxy-auth headers require a separate trust/direction policy.
  fnc proxy_auth(HeaderName header): bool {
    return header == HeaderName.ProxyAuthenticate ||
      header == HeaderName.ProxyAuthorization;
  }

  fnc request_sensitive(HeaderName header): bool {
    return header == HeaderName.Host ||
      header == HeaderName.ContentLength ||
      header == HeaderName.Authorization ||
      header == HeaderName.Cookie ||
      header == HeaderName.Forwarded ||
      header == HeaderName.XForwardedFor ||
      header == HeaderName.XForwardedHost ||
      header == HeaderName.XForwardedProto ||
      header == HeaderName.Via;
  }

  fnc response_unsupported(HeaderName header): bool {
    return header == HeaderName.ContentEncoding ||
      header == HeaderName.ContentRange;
  }

  fnc response_derived(HeaderName header): bool {
    return header == HeaderName.ContentLength ||
      header == HeaderName.Server ||
      header == HeaderName.Date;
  }

  // Do not copy Host or framing from inbound traffic. The future source-level
  // adapter will synthesize Host/SNI and Content-Length/TE from the validated
  // upstream, and owns exact response/body/trailer consistency.
  pub fnc request_copy(String key, String value,
                       String connection_tokens): bool {
    val HeaderName header = known_header(key);
    if !connection_safe(key, connection_tokens) || !value_safe(value) ||
      hop_by_hop(header) || proxy_auth(header) ||
      request_sensitive(header); then
      return false;
    fi
    return true;
  }

  // A boolean copy predicate MUST NOT be treated as a sufficient HTTP
  // transformation plan. Dropping content-encoding without decoding its bytes
  // would corrupt the response, and suppressing a Content-Range could violate
  // partial-response semantics. Return explicit reject/drop/keep decisions.
  pub fnc response_action(String key, String value,
                          String connection_tokens): Result<String, String> {
    if !token(key) || !value_safe(value); then
      return Err("invalid response header syntax");
    fi
    val HeaderName header = known_header(key);
    if response_unsupported(header); then
      return Err("response body transformation is unsupported");
    fi
    if !connection_safe(key, connection_tokens); then
      return Err("connection-nominated or invalid response header");
    fi
    if hop_by_hop(header) || proxy_auth(header) ||
      response_derived(header); then
      return Ok("drop");
    fi
    return Ok("keep");
  }

  // Multiple Set-Cookie lines must remain independent; callers cannot use
  // this scalar helper to coalesce them or make framing decisions.
  pub fnc response_copy(String key, String value,
                        String connection_tokens): bool {
    val HeaderName header = known_header(key);
    if !connection_safe(key, connection_tokens) || !value_safe(value) ||
      hop_by_hop(header) || proxy_auth(header) ||
      response_derived(header) || response_unsupported(header); then
      return false;
    fi
    return true;
  }
end
