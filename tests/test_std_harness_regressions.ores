import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, run_suite, require_success, fail from "ores.std/testing";
import module config_path from "../src/config_path";
fnc dotdot_config_path_denied(): TestOutcome {
  return expect_false(config_path.valid("/etc/proxy/../secret.toml"),
    "lexical parent traversal must be rejected before filesystem access");
}
fnc absolute_config_path_normalized(): TestOutcome {
  return expect_true(config_path.valid("/etc/proxy/config.toml") &&
    !config_path.valid("/etc//proxy/config.toml"),
    "safe absolute path accepted and doubled separator denied");
}
fnc relative_config_path_is_denied(): TestOutcome {
  return expect_false(config_path.valid("proxy/config.toml"),
    "configuration authority requires absolute POSIX paths");
}

fnc backslash_config_path_is_denied(): TestOutcome {
  return expect_false(config_path.valid("/etc/proxy\\secret.toml"),
    "backslashes must not bypass POSIX lexical path admission");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("reverse-proxy", arr[
    new TestCase("dotdot_config_path_denied", dotdot_config_path_denied, false, ""),
    new TestCase("absolute_config_path_normalized", absolute_config_path_normalized, false, ""),
    new TestCase("relative_config_path_is_denied", relative_config_path_is_denied, false, ""),
    new TestCase("backslash_config_path_is_denied", backslash_config_path_is_denied, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
