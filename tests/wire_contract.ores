import module proxy_wire from "../src/proxy_wire";
import module proxy_yaml from "../src/proxy_yaml";
pub routine main(): int {
  val good = proxy_wire.reverse("GET /api/v1 HTTP/1.1", "app.example.test");
  if good.is_err(); then stdio.println("FAIL reverse origin"); return 1; fi
  if good.unwrap().path != "/api/v1"; then return 1; fi
  if proxy_wire.reverse("GET http://evil.test/x HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("POST /api HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET //evil.test/x HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api%2fadmin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api/../admin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api/./admin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api;admin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api\u0001x HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api\u000badmin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api\u000cadmin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api\u001badmin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api\u001fadmin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api\u007fadmin HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api?token=x HTTP/1.1", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api HTTP/1.1\r\n", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api HTTP/1.0", "app.example.test").is_ok() ||
    proxy_wire.reverse("GET /api HTTP/1.1", "APP.EXAMPLE.TEST").is_ok(); then
    stdio.println("FAIL reverse request-line denial"); return 1;
  fi
  if proxy_wire.upstream_origin("http://127.0.0.1:9000").is_err() ||
    proxy_wire.upstream_origin("https://api.example.test:443").is_err() ||
    proxy_wire.upstream_origin("http://user@api.example.test:9000").is_ok() ||
    proxy_wire.upstream_origin("https://evil.test/internal").is_ok() ||
    proxy_wire.upstream_origin("https://evil.test:22").is_ok() ||
    proxy_wire.upstream_origin("https://[::1]:443").is_ok(); then
    stdio.println("FAIL upstream origin admission"); return 1;
  fi
  stdio.println("PASS reverse origin-form and upstream metadata grammar (no forwarding)");
  return 0;
}
