import module proxy_yaml from "../src/proxy_yaml";
import module route_policy from "../src/route_policy";
import module middleware_policy from "../src/middleware_policy";

pub routine main(): int {
  val String document = "version: ores.proxy/v1\nmode: reverse\nlisten:\n  host: 127.0.0.1\n  port: 8080\nruntime:\n  carriers: 20\n  actors: 100\n  max_inflight: 1024\n" +
    "middleware:\n  - name: guard\n    kind: require_header\n    header: x-token\nroutes:\n  - name: app\n    host: app.example.test\n    path_prefix: /api\n    upstream: http://127.0.0.1:9000\n    middleware: guard\n";
  val parsed = proxy_yaml.parse(document, "reverse");
  if parsed.is_err(); then stdio.println("FAIL valid fixture"); return 1; fi
  val snapshot = parsed.unwrap();
  if proxy_yaml.parse(document + "mode: reverse\n", "reverse").is_ok(); then
    stdio.println("FAIL duplicate root"); return 1;
  fi
  if proxy_yaml.parse(document.replace_literal("  actors: 100", "  actors: 0"), "reverse").is_ok(); then
    stdio.println("FAIL actor admission"); return 1;
  fi
  if !route_policy.prefix_match("/api", "/api/x") || route_policy.prefix_match("/api", "/api2"); then
    stdio.println("FAIL route/domain boundary"); return 1;
  fi
  val result = route_policy.select(rt borrow snapshot, "app.example.test", "/api/hello");
  if result.is_err(); then stdio.println("FAIL route match"); return 1; fi
  if middleware_policy.evaluate(rt borrow snapshot, result.unwrap().middleware, "x-token", "").unwrap(); then
    stdio.println("FAIL middleware denial"); return 1; fi
  if proxy_yaml.parse(document.replace_literal("app.example.test", "app..example.test"), "reverse").is_ok(); then
    stdio.println("FAIL invalid reverse route host"); return 1;
  fi
  if proxy_yaml.parse(document.replace_literal("- name: guard", "- name: x- guard")
      .replace_literal("middleware: guard", "middleware: x- guard"), "reverse").is_ok(); then
    stdio.println("FAIL ambiguous middleware name"); return 1;
  fi
  if proxy_yaml.parse(document + "  # trailing comment\r\n", "reverse").is_ok(); then
    stdio.println("FAIL CR on comment"); return 1;
  fi
  // A bounded native parser must not walk arbitrarily many comment lines.
  let String padding = "# bounded comment\n";
  for (let i = 0; i < 12; i++) {
    padding = padding + padding;
  }
  if proxy_yaml.parse(document + padding, "reverse").is_ok(); then
    stdio.println("FAIL YAML line budget"); return 1;
  fi
  // Syntax checks are configuration admission only: transport must still
  // enforce HTTP framing, pinned resolution, port bounds and TLS validation.
  if !proxy_yaml.valid_upstream_origin("https://api.example.test:443") ||
    !proxy_yaml.valid_upstream_origin("http://127.0.0.1:9000") ||
    !proxy_yaml.valid_upstream_origin("http://localhost:8080"); then
    stdio.println("FAIL canonical upstream origin"); return 1;
  fi
  if proxy_yaml.valid_upstream_origin("http://") ||
    proxy_yaml.valid_upstream_origin("http:///admin") ||
    proxy_yaml.valid_upstream_origin("http://api.example.test/admin") ||
    proxy_yaml.valid_upstream_origin("http://user@api.example.test") ||
    proxy_yaml.valid_upstream_origin("http://api.example.test%2Fadmin") ||
    proxy_yaml.valid_upstream_origin("http://api.example.test:0") ||
    proxy_yaml.valid_upstream_origin("ftp://api.example.test"); then
    stdio.println("FAIL ambiguous upstream authority"); return 1;
  fi
  if !proxy_yaml.valid_header_name("x-trace-id") ||
    proxy_yaml.valid_header_name("X-Trace-ID") ||
    proxy_yaml.valid_header_name("x_trace") ||
    proxy_yaml.valid_header_name("x-header:forged") ||
    proxy_yaml.valid_header_name("-bad"); then
    stdio.println("FAIL canonical policy header"); return 1;
  fi
  if proxy_yaml.parse(document.replace_literal("path_prefix: /api",
      "path_prefix: /api/../admin"), "reverse").is_ok() ||
    proxy_yaml.parse(document.replace_literal("path_prefix: /api",
      "path_prefix: /api%2Fadmin"), "reverse").is_ok() ||
    proxy_yaml.parse(document.replace_literal("path_prefix: /api",
      "path_prefix: /api/"), "reverse").is_ok() ||
    proxy_yaml.parse(document.replace_literal("upstream: http://127.0.0.1:9000",
      "upstream: http://127.0.0.1:9000/steal"), "reverse").is_ok() ||
    proxy_yaml.parse(document.replace_literal("header: x-token",
      "header: X-Token"), "reverse").is_ok(); then
    stdio.println("FAIL reverse proxy origin/path/header admission"); return 1;
  fi
  // Source parser and HTTP request-path guard must agree: a configured
  // path containing any '..' cannot ever be a runtime-dispatchable prefix.
  // Reject both a traversal-like prefix and dots embedded in one segment.
  if proxy_yaml.parse(document.replace_literal("path_prefix: /api",
      "path_prefix: /api/..x"), "reverse").is_ok() ||
    proxy_yaml.parse(document.replace_literal("path_prefix: /api",
      "path_prefix: /api..v2"), "reverse").is_ok(); then
    stdio.println("FAIL configured prefix escaped strict request-path grammar");
    return 1;
  fi
  // Distinct middleware stages remain admissible; the duplicate rule is
  // not a blanket ban on legitimate multi-stage routes.
  val String two_steps = document
    .replace_literal("routes:\n",
      "  - name: audit\n    kind: trace\nroutes:\n")
    .replace_literal("middleware: guard\n",
      "middleware: guard,audit\n");
  if proxy_yaml.parse(two_steps, "reverse").is_err(); then
    stdio.println("FAIL distinct middleware pipeline rejected");
    return 1;
  fi
  // Repeated middleware identifiers are ambiguous across policy consumers;
  // parser admission rejects duplicate steps rather than normalizing them.
  if proxy_yaml.parse(document.replace_literal("middleware: guard",
      "middleware: guard,guard"), "reverse").is_ok() ||
    proxy_yaml.parse(document.replace_literal("middleware: guard",
      "middleware: guard,missing"), "reverse").is_ok() ||
    proxy_yaml.parse(document.replace_literal("middleware: guard",
      "middleware: guard,,guard"), "reverse").is_ok(); then
    stdio.println("FAIL duplicate or malformed middleware route chain");
    return 1;
  fi
  // Most-specific prefix must win even when the broad route appears first.
  val String admin = "  - name: admin\n    host: app.example.test\n    path_prefix: /api/admin\n    upstream: http://127.0.0.1:9001\n    middleware: guard\n";
  val first_broad = proxy_yaml.parse(document + admin, "reverse");
  if first_broad.is_err(); then
    stdio.println("FAIL nested route admission"); return 1;
  fi
  val broad_snapshot = first_broad.unwrap();
  val chosen = route_policy.select(rt borrow broad_snapshot,
      "app.example.test", "/api/admin/users");
  if chosen.is_err() || chosen.unwrap().name != "admin"; then
    stdio.println("FAIL most-specific route selection"); return 1;
  fi
  val unprivileged = route_policy.select(rt borrow broad_snapshot,
      "app.example.test", "/api/users");
  if unprivileged.is_err() || unprivileged.unwrap().name != "app"; then
    stdio.println("FAIL broad route selection"); return 1;
  fi
  val String original_item = "  - name: app\n";
  val first_specific = proxy_yaml.parse(document.replace_literal(original_item,
      admin + original_item), "reverse");
  if first_specific.is_err(); then
    stdio.println("FAIL reversed route order"); return 1;
  fi
  val specific_snapshot = first_specific.unwrap();
  val reversed = route_policy.select(rt borrow specific_snapshot,
      "app.example.test", "/api/admin/users");
  if reversed.is_err() || reversed.unwrap().name != "admin"; then
    stdio.println("FAIL order-independent longest prefix"); return 1;
  fi
  stdio.println("PASS native reverse YAML/policy contract");
  return 0;
}
