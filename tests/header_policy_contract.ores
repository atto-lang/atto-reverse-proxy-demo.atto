import module header_policy from "../src/header_policy";
pub routine main(): int {
  if !header_policy.request_copy("accept", "text/plain", "") ||
    !header_policy.request_copy("x-request-id", "123", "") ||
    !header_policy.response_copy("set-cookie", "session=a; Secure", "") ||
    !header_policy.response_copy("content-type", "text/plain", ""); then
    stdio.println("FAIL safe header retention"); return 1;
  fi
  if header_policy.request_copy("connection", "keep-alive", "") ||
    header_policy.request_copy("host", "evil.test", "") ||
    header_policy.request_copy("content-length", "10", "") ||
    header_policy.request_copy("proxy-authorization", "Basic sensitive", "") ||
    header_policy.request_copy("authorization", "Bearer secret", "") ||
    header_policy.request_copy("x-forwarded-for", "127.0.0.1", "") ||
    header_policy.request_copy("x-custom", "fine", "x-custom, keep-alive") ||
    header_policy.request_copy("x-custom", "fine", "x-custom,") ||
    header_policy.request_copy("x-custom", "fine", "keep-alive,") ||
    header_policy.request_copy("x-custom", "fine", ",keep-alive") ||
    header_policy.request_copy("X-CUSTOM", "fine", "") ||
    header_policy.request_copy("x-custom", "x\u0001y", "") ||
    header_policy.request_copy("x-custom", "x\u0007y", "") ||
    header_policy.request_copy("x-custom", "x\u000by", "") ||
    header_policy.request_copy("x-custom", "x\u000cy", "") ||
    header_policy.request_copy("x-custom", "x\u001by", "") ||
    header_policy.request_copy("x-custom", "x\u001fy", "") ||
    header_policy.request_copy("x-custom", "x\u007fy", "") ||
    header_policy.response_copy("x-custom", "x\u000by", "") ||
    !header_policy.response_action("x-custom", "x\u007fy", "").is_err() ||
    header_policy.request_copy("x-custom", "ok\r\nInjected: yes", "") ||
    header_policy.request_copy("x:evil", "fine", "") ||
    header_policy.response_copy("transfer-encoding", "chunked", "") ||
    header_policy.response_copy("content-length", "200", "") ||
    header_policy.response_copy("x-custom", "value", "x-custom") ||
    header_policy.response_copy("x-custom", "value", "x-custom,") ||
    header_policy.response_copy("content-encoding", "gzip", "") ||
    header_policy.response_copy("content-range", "bytes 0-9/20", "") ||
    header_policy.response_copy("bad name", "x", ""); then
    stdio.println("FAIL forbidden header"); return 1;
  fi
  // Exhaust the full ASCII C0 + DEL rejection set. Representative
  // request_copy/response_copy cases above additionally test call-site wiring.
  if header_policy.value_safe("safe\u0000value") ||
    header_policy.value_safe("safe\u0001value") ||
    header_policy.value_safe("safe\u0002value") ||
    header_policy.value_safe("safe\u0003value") ||
    header_policy.value_safe("safe\u0004value") ||
    header_policy.value_safe("safe\u0005value") ||
    header_policy.value_safe("safe\u0006value") ||
    header_policy.value_safe("safe\u0007value") ||
    header_policy.value_safe("safe\u0008value") ||
    header_policy.value_safe("safe\u0009value") ||
    header_policy.value_safe("safe\u000avalue") ||
    header_policy.value_safe("safe\u000bvalue") ||
    header_policy.value_safe("safe\u000cvalue") ||
    header_policy.value_safe("safe\u000dvalue") ||
    header_policy.value_safe("safe\u000evalue") ||
    header_policy.value_safe("safe\u000fvalue") ||
    header_policy.value_safe("safe\u0010value") ||
    header_policy.value_safe("safe\u0011value") ||
    header_policy.value_safe("safe\u0012value") ||
    header_policy.value_safe("safe\u0013value") ||
    header_policy.value_safe("safe\u0014value") ||
    header_policy.value_safe("safe\u0015value") ||
    header_policy.value_safe("safe\u0016value") ||
    header_policy.value_safe("safe\u0017value") ||
    header_policy.value_safe("safe\u0018value") ||
    header_policy.value_safe("safe\u0019value") ||
    header_policy.value_safe("safe\u001avalue") ||
    header_policy.value_safe("safe\u001bvalue") ||
    header_policy.value_safe("safe\u001cvalue") ||
    header_policy.value_safe("safe\u001dvalue") ||
    header_policy.value_safe("safe\u001evalue") ||
    header_policy.value_safe("safe\u001fvalue") ||
    header_policy.value_safe("safe\u007fvalue"); then
    stdio.println("FAIL C0/DEL header value admitted"); return 1;
  fi
  if !header_policy.response_action("content-encoding", "gzip", "").is_err() ||
    !header_policy.response_action("content-range", "bytes 0-9/20", "").is_err() ||
    header_policy.response_action("content-length", "2", "").unwrap() != "drop" ||
    header_policy.response_action("set-cookie", "a=b", "").unwrap() != "keep" ||
    !header_policy.response_action("x-extra", "ok", "x-extra").is_err(); then
    stdio.println("FAIL explicit response action"); return 1;
  fi
  stdio.println("PASS canonical header policy (raw wire parser still required)");
  return 0;
}
