// Pure native Oreslang load-balancer schema + scheduling regression tests.
// No network forwarding, DNS or concurrent reservations are exercised.
import module proxy_yaml from "../src/proxy_yaml";
import module lb_policy from "../src/lb_policy";

pub routine main(): int {
  val String base = "version: ores.proxy/v1\nmode: reverse\nlisten:\n  host: 127.0.0.1\n  port: 8080\nruntime:\n  carriers: 20\n  actors: 100\n  max_inflight: 1024\nroutes:\n  - name: main\n    host: app.example.test\n    path_prefix: /\n    upstream: pool:app-pool\n";
  val String pools = "upstreams:\n  - name: app-pool\n    algorithm: weighted_round_robin\n    origins: http://a.example.test:9000,https://b.example.test:9443\n    weights: 3,1\n    max_connections: 128\n";
  val String document = base + pools;
  val parsed = proxy_yaml.parse(document, "reverse");
  if parsed.is_err(); then stdio.println("FAIL valid upstream pool YAML"); return 1; fi
  val config = parsed.unwrap();
  if config.upstreams.size != 1 || config.routes.size != 1 ||
     config.routes.get(0).upstream != "pool:app-pool"; then
    stdio.println("FAIL pool/route config snapshot"); return 1;
  fi
  val pool = config.upstreams.get(0);
  let Array<bool> healthy = new Array<bool>();
  let Array<int> counts = new Array<int>();
  healthy.add(true); healthy.add(true);
  counts.add(0); counts.add(0);

  for (let i = 0; i < 4; i++) {
    val picked = lb_policy.choose(rt borrow pool, 7, healthy, counts, i);
    if picked.is_err(); then stdio.println("FAIL weighted scheduler"); return 1; fi
    val chosen = picked.unwrap();
    if chosen.epoch != 7 || chosen.index != (i == 3 ? 1 : 0); then
      stdio.println("FAIL expected 3:1 weights and pinned epoch"); return 1;
    fi
  }
  if lb_policy.choose(rt borrow pool, 7, healthy, counts, 4).is_ok() ||
     lb_policy.choose(rt borrow pool, 0, healthy, counts, 0).is_ok(); then
    stdio.println("FAIL ordinal/epoch bounds"); return 1;
  fi

  let Array<bool> one_live = new Array<bool>();
  one_live.add(false); one_live.add(true);
  if lb_policy.choose(rt borrow pool, 7, one_live, counts, 0).unwrap().index != 1 ||
     lb_policy.choose(rt borrow pool, 7, one_live, counts, 1).is_ok(); then
    stdio.println("FAIL unhealthy failover or recomputed weight"); return 1;
  fi
  let Array<int> saturated = new Array<int>();
  saturated.add(128); saturated.add(0);
  if lb_policy.choose(rt borrow pool, 7, healthy, saturated, 0).unwrap().index != 1; then
    stdio.println("FAIL capacity failover"); return 1;
  fi
  saturated = new Array<int>();
  saturated.add(128); saturated.add(128);
  if lb_policy.choose(rt borrow pool, 7, healthy, saturated, 0).is_ok(); then
    stdio.println("FAIL all saturated must reject"); return 1;
  fi
  let Array<bool> none_live = new Array<bool>();
  none_live.add(false); none_live.add(false);
  if lb_policy.choose(rt borrow pool, 7, none_live, counts, 0).is_ok(); then
    stdio.println("FAIL all unhealthy must reject"); return 1;
  fi
  let Array<int> forged = new Array<int>();
  forged.add(-1); forged.add(0);
  if lb_policy.choose(rt borrow pool, 7, healthy, forged, 0).is_ok(); then
    stdio.println("FAIL negative active count"); return 1;
  fi

  val least_yaml = document.replace_literal("weighted_round_robin", "least_conn");
  val least_parsed = proxy_yaml.parse(least_yaml, "reverse");
  if least_parsed.is_err(); then stdio.println("FAIL least-conn admission"); return 1; fi
  val least = least_parsed.unwrap().upstreams.get(0);
  let Array<int> loads = new Array<int>();
  loads.add(9); loads.add(1);
  if lb_policy.choose(rt borrow least, 7, healthy, loads, 0).unwrap().index != 1; then
    stdio.println("FAIL normalized weighted least connections"); return 1;
  fi
  loads = new Array<int>();
  loads.add(3); loads.add(1);
  if lb_policy.choose(rt borrow least, 7, healthy, loads, 0).unwrap().index != 0 ||
     lb_policy.choose(rt borrow least, 7, healthy, loads, 1).unwrap().index != 1; then
    stdio.println("FAIL rotating least-conn tie"); return 1;
  fi
  if lb_policy.choose(rt borrow least, 7, healthy, loads, 2).is_ok(); then
    stdio.println("FAIL tie ordinal bounds"); return 1;
  fi

  if proxy_yaml.parse(document.replace_literal("pool:app-pool", "pool:missing"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("weights: 3,1", "weights: 0,1"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("weights: 3,1", "weights: 17,1"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("weights: 3,1", "weights: 3,1,1"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("max_connections: 128", "max_connections: 2048"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("algorithm: weighted_round_robin", "algorithm: random"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("http://a.example.test:9000", "http://user@a.example.test:9000"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("https://b.example.test:9443", "https://a.example.test:9000"), "reverse").is_ok() ||
     proxy_yaml.parse(document.replace_literal("    weights: 3,1\n", "    weights: 3,1\n    weights: 3,1\n"), "reverse").is_ok() ||
     proxy_yaml.parse(base, "reverse").is_ok(); then
    stdio.println("FAIL invalid pool or unresolved route reference"); return 1;
  fi
  if proxy_yaml.parse(document + pools.replace_literal("upstreams:\n", ""), "reverse").is_ok(); then
    stdio.println("FAIL duplicate pool name"); return 1;
  fi
  // A raw origin must remain supported for backward-compatible v1 snapshots.
  val direct = base.replace_literal("pool:app-pool", "http://a.example.test:9000");
  if proxy_yaml.parse(direct, "reverse").is_err(); then
    stdio.println("FAIL legacy direct upstream"); return 1;
  fi
  stdio.println("PASS pure YAML upstream pools and bounded LB scheduling");
  return 0;
}
